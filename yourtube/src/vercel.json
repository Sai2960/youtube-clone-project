{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "@youtube-api-url",
    "NEXT_PUBLIC_BACKEND_URL": "@youtube-backend-url"
  },
  "functions": {
    "app/**/*.tsx": {
      "maxDuration": 30
    }
  }
}